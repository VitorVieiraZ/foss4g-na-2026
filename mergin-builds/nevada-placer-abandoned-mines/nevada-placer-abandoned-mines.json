{
  "title": "Abandoned mine survey - Nevada & Placer counties",
  "project_name": "nevada-placer-abandoned-mines",
  "mode": "new",
  "qgis_version": "3.42",
  "parent_folder": "MerginMaps Projects",
  "crs": "EPSG:4326",
  "area_of_interest": {"bbox": [-121.48, 38.71, -120.00, 39.53], "label": "Nevada & Placer counties, CA"},
  "background": "mergin",
  "app_settings": {
    "photo_quality": 1,
    "snapping": 0,
    "position_tracking": true,
    "tracking_frequency": "normal",
    "layer_order": "qgis",
    "filters": [
      {"layer": "mine_features", "field": "hazard_rating", "name": "Hazard rating"},
      {"layer": "mine_features", "field": "status", "name": "Status"}
    ]
  },
  "lookup_lists": {
    "mine_names": ["Empire", "North Star", "Idaho-Maryland", "Pennsylvania", "Unknown"],
    "hazard_types": ["Vertical drop", "Unstable ground", "Bad air", "Water", "Bats", "Debris"]
  },
  "layers": [
    {"name": "mine_features", "geometry": "point", "title": "feature_id", "color": "#c2410c",
     "multiple_photos": true,
     "fields": [
       {"name": "feature_id", "type": "text", "alias": "Feature ID", "widget": "text", "required": true, "tab": "General",
        "constraint": {"expression": "regexp_match(\"feature_id\", '^AM-[0-9]{4}$')", "message": "Use the format AM-0000", "hard": true}},
       {"name": "feature_type", "type": "text", "alias": "Feature type", "widget": "dropdown", "tab": "General",
        "choices": ["Adit", "Shaft", "Prospect pit", "Headframe", "Mill ruin", "Tailings pile", "Other"]},
       {"name": "mine_name", "type": "text", "alias": "Mine name", "widget": "lookup", "list": "mine_names", "tab": "General"},
       {"name": "status", "type": "text", "alias": "Status", "widget": "dropdown", "required": true, "tab": "General",
        "choices": ["Open", "Partly closed", "Gated", "Backfilled"],
        "constraint": {"expression": "@position_horizontal_accuracy IS NULL OR @position_horizontal_accuracy <= 5", "message": "GPS accuracy is worse than 5 m", "hard": false}},
       {"name": "width_ft", "type": "decimal", "alias": "Width (ft)", "widget": "number", "min": 0, "max": 500, "tab": "Hazard", "group": "Opening"},
       {"name": "depth_ft", "type": "decimal", "alias": "Depth (ft)", "widget": "number", "min": 0, "max": 500, "tab": "Hazard", "group": "Opening"},
       {"name": "safe_to_approach", "type": "boolean", "alias": "Safe to approach?", "widget": "checkbox", "tab": "Hazard", "group": "Opening"},
       {"name": "hazard_rating", "type": "text", "alias": "Hazard rating", "widget": "dropdown", "tab": "Hazard", "group": "Risk",
        "choices": ["Low", "Medium", "High", "Extreme"]},
       {"name": "hazards_present", "type": "text", "alias": "Hazards present", "widget": "lookup", "list": "hazard_types", "multiple": true, "tab": "Hazard", "group": "Risk"},
       {"name": "inspection_date", "type": "date", "alias": "Inspection date", "widget": "date", "default": "now()", "tab": "Visit"},
       {"name": "inspector", "type": "text", "alias": "Inspector", "widget": "text", "default": "@mm_username", "tab": "Visit"},
       {"name": "notes", "type": "text", "alias": "Notes", "widget": "notes", "tab": "Visit",
        "constraint": {"expression": "coalesce(\"hazard_rating\", '') NOT IN ('High', 'Extreme') OR length(trim(\"notes\")) > 0", "message": "Describe the hazard", "hard": true}}
     ]},
    {"name": "tailings_areas", "geometry": "polygon", "title": "material", "color": "#ffad42",
     "fields": [
       {"name": "material", "type": "text", "alias": "Material", "widget": "dropdown", "choices": ["Sand", "Slimes", "Waste rock"]},
       {"name": "visible_erosion", "type": "boolean", "alias": "Visible erosion?", "widget": "checkbox"},
       {"name": "photo", "type": "text", "alias": "Photo", "widget": "photo"}
     ]},
    {"name": "access_roads", "geometry": "line", "title": "condition", "color": "#5e9ee4",
     "fields": [
       {"name": "condition", "type": "text", "alias": "Condition", "widget": "dropdown", "choices": ["Good", "4x4 only", "Impassable"]},
       {"name": "gate_locked", "type": "boolean", "alias": "Gate locked?", "widget": "checkbox"}
     ]}
  ]
}
