{
  "title": "Sierra foothills geology mapping",
  "project_name": "sierra-foothills-geology",
  "qgis_version": "3.42",
  "crs": "EPSG:4326",
  "area_of_interest": {
    "bbox": [
      -121.2,
      38.55,
      -120.75,
      38.95
    ],
    "label": "Folsom to Placerville, CA"
  },
  "background": "mergin",
  "app_settings": {
    "photo_quality": 1,
    "position_tracking": true,
    "tracking_frequency": "normal",
    "map_sketching": true,
    "photo_sketching": true,
    "layer_order": "qgis",
    "selective_sync": true,
    "selective_sync_folder": "photos",
    "filters": [
      {
        "layer": "outcrops",
        "field": "rock_type",
        "name": "Rock type"
      },
      {
        "layer": "outcrops",
        "field": "created_by",
        "name": "Geologist"
      },
      {
        "layer": "map_units",
        "field": "unit",
        "name": "Geologic unit"
      }
    ],
    "snapping": 1
  },
  "lookup_lists": {
    "geologic_units": [
      "Mehrten Formation",
      "Valley Springs Formation",
      "Ione Formation",
      "Folsom granodiorite",
      "Copper Hill Volcanics",
      "Alluvium"
    ]
  },
  "layers": [
    {
      "name": "outcrops",
      "geometry": "point",
      "title": "outcrop_id",
      "color": "#e1312d",
      "fields": [
        {
          "name": "outcrop_id",
          "type": "text",
          "alias": "Outcrop ID",
          "widget": "text",
          "required": true,
          "constraint": {
            "expression": "@position_horizontal_accuracy IS NULL OR @position_horizontal_accuracy <= 10",
            "message": "GPS accuracy is worse than 10 m. Wait for a better fix, or note it in Notes.",
            "hard": false
          }
        },
        {
          "name": "rock_type",
          "type": "text",
          "alias": "Rock type",
          "widget": "dropdown",
          "choices": [
            "Sandstone",
            "Shale",
            "Conglomerate",
            "Granite",
            "Basalt",
            "Schist",
            "Other"
          ],
          "required": true
        },
        {
          "name": "unit",
          "type": "text",
          "alias": "Geologic unit",
          "widget": "lookup",
          "list": "geologic_units"
        },
        {
          "name": "strike",
          "type": "integer",
          "alias": "Strike (°)",
          "widget": "number",
          "constraint": {
            "expression": "\"strike\" IS NULL OR (\"strike\" >= 0 AND \"strike\" <= 360)",
            "message": "Strike must be between 0 and 360°."
          },
          "min": 0,
          "max": 360
        },
        {
          "name": "dip",
          "type": "integer",
          "alias": "Dip (°)",
          "widget": "number",
          "constraint": {
            "expression": "\"dip\" IS NULL OR (\"dip\" >= 0 AND \"dip\" <= 90)",
            "message": "Dip must be between 0 and 90°."
          },
          "min": 0,
          "max": 90
        },
        {
          "name": "sample_taken",
          "type": "boolean",
          "alias": "Sample taken?",
          "widget": "checkbox"
        },
        {
          "name": "notes",
          "type": "text",
          "alias": "Notes",
          "widget": "notes"
        }
      ],
      "multiple_photos": true
    },
    {
      "name": "contacts",
      "geometry": "line",
      "title": "contact_type",
      "color": "#0e3b31",
      "fields": [
        {
          "name": "contact_type",
          "type": "text",
          "alias": "Contact type",
          "widget": "dropdown",
          "choices": [
            "Conformable",
            "Unconformity",
            "Fault",
            "Intrusive"
          ],
          "required": true
        },
        {
          "name": "certainty",
          "type": "text",
          "alias": "Certainty",
          "widget": "dropdown",
          "choices": [
            "Observed",
            "Inferred",
            "Concealed"
          ],
          "required": true
        }
      ]
    },
    {
      "name": "map_units",
      "geometry": "polygon",
      "title": "unit",
      "color": "#f6a463",
      "fields": [
        {
          "name": "unit",
          "type": "text",
          "alias": "Geologic unit",
          "widget": "lookup",
          "list": "geologic_units",
          "required": true
        },
        {
          "name": "mapped_from",
          "type": "text",
          "alias": "Mapped from",
          "widget": "dropdown",
          "choices": [
            "Field observation",
            "Air photo",
            "Existing map"
          ]
        }
      ]
    }
  ]
}